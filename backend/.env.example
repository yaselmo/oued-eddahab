DATABASE_URL="postgresql://oued:oued_dev@localhost:5432/oued_eddahab?schema=public"
JWT_SECRET="replace-with-a-long-random-secret"
PORT=5000

# Keep local storage for development. Set to "r2" only after creating the
# private bucket and configuring all four R2 values below on the backend host.
RESOURCE_STORAGE_DRIVER="local"
# Cloudflare account ID (not a zone ID).
R2_ACCOUNT_ID=""
# Private R2 bucket name.
R2_BUCKET_NAME=""
# Bucket-scoped R2 S3 credentials with Object Read & Write permission.
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
