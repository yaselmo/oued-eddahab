generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ======================================================
// USERS
// ======================================================

model User {
  id       String @id @default(uuid())
  email    String @unique
  username String @unique
  password String

  // Basic profile
  firstName String
  lastName  String
  bio       String?
  avatarUrl String?

  // Personal information
  age         Int?
  city        String?
  country     String? @default("Morocco")
  nationality String?
  phone       String?

  languages String[] @default([])
  interests String[] @default([])

  sex Sex?

  // Academic information
  program String?
  year    Int?

  institutionId String?
  institution   Institution? @relation(fields: [institutionId], references: [id], onDelete: SetNull)

  // Email verification
  emailVerifiedAt DateTime?

  role UserRole @default(STUDENT)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  posts           Post[]
  comments        Comment[]
  likes           Like[]
  clubMemberships ClubMember[]
  eventAttendance EventAttendee[]
  studyResources  StudyResource[]

  @@index([institutionId])
  @@index([city])
  @@index([country])
}

enum UserRole {
  STUDENT
  MODERATOR
  ADMIN
}

enum Sex {
  MALE
  FEMALE
  OTHER
  PREFER_NOT_TO_SAY
}

// ======================================================
// CLUBS
// ======================================================

model Club {
  id          String  @id @default(uuid())
  name        String
  slug        String  @unique
  description String?
  logoUrl     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members ClubMember[]
  posts   Post[]
  events  Event[]
}

model ClubMember {
  id String @id @default(uuid())

  userId String
  clubId String

  role ClubRole @default(MEMBER)

  joinedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  club Club @relation(fields: [clubId], references: [id], onDelete: Cascade)

  @@unique([userId, clubId])
  @@index([clubId])
  @@index([userId])
}

enum ClubRole {
  MEMBER
  MODERATOR
  ADMIN
}

// ======================================================
// POSTS
// ======================================================

model Post {
  id      String @id @default(uuid())
  content String

  authorId String
  clubId   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  author User  @relation(fields: [authorId], references: [id], onDelete: Cascade)
  club   Club? @relation(fields: [clubId], references: [id], onDelete: Cascade)

  comments Comment[]
  likes    Like[]

  @@index([authorId])
  @@index([clubId])
  @@index([createdAt])
}

// ======================================================
// COMMENTS
// ======================================================

model Comment {
  id      String @id @default(uuid())
  content String

  authorId String
  postId   String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  author User @relation(fields: [authorId], references: [id], onDelete: Cascade)
  post   Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([authorId])
  @@index([postId])
}

// ======================================================
// LIKES
// ======================================================

model Like {
  id String @id @default(uuid())

  userId String
  postId String

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([userId, postId])
  @@index([userId])
  @@index([postId])
}

// ======================================================
// EVENTS / MEETINGS
// ======================================================

model Event {
  id          String  @id @default(uuid())
  title       String
  description String?

  location String?

  startsAt DateTime
  endsAt   DateTime?

  clubId String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  club Club @relation(fields: [clubId], references: [id], onDelete: Cascade)

  attendees EventAttendee[]

  @@index([clubId])
  @@index([startsAt])
}

model EventAttendee {
  id String @id @default(uuid())

  userId  String
  eventId String

  status AttendanceStatus @default(GOING)

  createdAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([userId, eventId])
  @@index([userId])
  @@index([eventId])
}

enum AttendanceStatus {
  GOING
  INTERESTED
}

// ======================================================
// UNIVERSITIES
// ======================================================

model University {
  id         String  @id @default(cuid())
  name       String  @unique
  nameArabic String?

  country String @default("Morocco")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  institutions Institution[]

  @@index([country])
}

// ======================================================
// INSTITUTIONS / SCHOOLS
// ======================================================

model Institution {
  id String @id @default(cuid())

  name         String
  abbreviation String?
  nameArabic   String?

  city    String
  country String @default("Morocco")

  address String?
  phone   String?
  fax     String?

  studentCount2023_2024 Int?

  universityId String
  university   University @relation(fields: [universityId], references: [id], onDelete: Cascade)

  users          User[]
  courses        Course[]
  studyResources StudyResource[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([name, city])
  @@index([city])
  @@index([country])
  @@index([universityId])
}

// ======================================================
// STUDY RESOURCES
// ======================================================

enum ResourceType {
  NOTES
  SUMMARY
  EXAM
  EXERCISE
  ASSIGNMENT
  OTHER
}

model Course {
  id   String  @id @default(uuid())
  name String
  code String?

  institutionId String
  institution   Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)

  resources StudyResource[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([institutionId])
  @@index([institutionId, name])
  @@index([institutionId, code])
}

model StudyResource {
  id          String       @id @default(uuid())
  title       String
  description String?
  fileUrl     String
  fileName    String
  fileSize    Int?
  type        ResourceType

  academicYear String?
  professor    String?

  uploaderId    String
  institutionId String
  courseId      String?

  uploader    User        @relation(fields: [uploaderId], references: [id], onDelete: Cascade)
  institution Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  course      Course?     @relation(fields: [courseId], references: [id], onDelete: SetNull)

  views     Int @default(0)
  downloads Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([institutionId, createdAt])
  @@index([institutionId, type])
  @@index([courseId])
  @@index([uploaderId])
}
