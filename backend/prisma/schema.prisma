generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ======================================================
// USERS
// ======================================================

model User {
  id       String @id @default(uuid())
  email    String @unique
  username String @unique
  password String

  // Basic profile
  firstName String
  lastName  String
  bio       String?
  avatarUrl String?

  // Personal information
  age         Int?
  city        String?
  country     String? @default("Morocco")
  nationality String?
  phone       String?

  languages String[] @default([])
  interests String[] @default([])

  sex Sex?

  // Academic information
  program String?
  year    Int?

  institutionId String?
  institution   Institution? @relation(fields: [institutionId], references: [id], onDelete: SetNull)

  // Email verification
  emailVerifiedAt DateTime?

  role UserRole @default(STUDENT)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt


  // Posts
  posts     Post[]
  comments  Comment[]
  likes     Like[]
  postVotes PostVote[]

  // Clubs
  clubMemberships ClubMember[]
  clubsCreated    Club[] @relation("ClubCreator")
  clubsReviewed   Club[] @relation("ClubReviewer")

  // Communities
  createdCommunities   Community[] @relation("CommunityCreator")
  communityMemberships CommunityMember[]

  // Events
  eventAttendance EventAttendee[]

  // Study resources
  studyResources StudyResource[]
  resourceViews  ResourceView[]


  @@index([institutionId])
  @@index([city])
  @@index([country])
}

enum UserRole {
  STUDENT
  MODERATOR
  ADMIN
}

enum Sex {
  MALE
  FEMALE
  OTHER
  PREFER_NOT_TO_SAY
}

// ======================================================
// CLUBS
// ======================================================

enum ClubStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ClubCategory {
  TECH
  SPORT
  CULTURE
  ART
  SCIENCE
  SOCIAL
  ENTREPRENEURSHIP
  OTHER
}

model Club {
  id          String  @id @default(uuid())
  name        String
  slug        String  @unique
  description String?
  logoUrl     String?

  // Logo stored on disk by the clubs module (served through /api/clubs/:id/logo).
  logoFileName String?

  category       ClubCategory @default(OTHER)
  activities     String?
  additionalInfo String?

  responsibleName  String
  responsibleEmail String

  // A club is public only once an administrator of its institution approves it.
  status          ClubStatus @default(PENDING)
  rejectionReason String?
  reviewedAt      DateTime?

  institutionId String
  createdById   String
  reviewedById  String?

  institution Institution @relation(fields: [institutionId], references: [id], onDelete: Restrict)
  createdBy   User        @relation("ClubCreator", fields: [createdById], references: [id], onDelete: Restrict)
  reviewedBy  User?       @relation("ClubReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members ClubMember[]
  posts   Post[]
  events  Event[]

  @@index([institutionId, status])
  @@index([createdById])
}

// ======================================================
// DISCUSSION COMMUNITIES
// ======================================================

model Community {
  id          String  @id @default(uuid())
  name        String
  slug        String  @unique
  description String
  imageUrl    String?

  creatorId     String
  institutionId String?
  memberCount   Int     @default(0)

  creator     User              @relation("CommunityCreator", fields: [creatorId], references: [id], onDelete: Restrict)
  institution Institution?      @relation(fields: [institutionId], references: [id], onDelete: SetNull)
  members     CommunityMember[]
  posts       Post[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([creatorId])
  @@index([institutionId])
  @@index([memberCount])
  @@index([createdAt])
}

model CommunityMember {
  id String @id @default(uuid())

  userId      String
  communityId String
  role        CommunityRole @default(MEMBER)
  joinedAt    DateTime      @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  community Community @relation(fields: [communityId], references: [id], onDelete: Cascade)

  @@unique([userId, communityId])
  @@index([communityId, joinedAt])
  @@index([userId])
}

enum CommunityRole {
  MEMBER
  MODERATOR
  ADMIN
}

model ClubMember {
  id String @id @default(uuid())

  userId String
  clubId String

  role ClubRole @default(MEMBER)

  joinedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  club Club @relation(fields: [clubId], references: [id], onDelete: Cascade)

  @@unique([userId, clubId])
  @@index([clubId])
  @@index([userId])
}

enum ClubRole {
  MEMBER
  MODERATOR
  ADMIN
}

// ======================================================
// POSTS
// ======================================================

model Post {
  id      String  @id @default(uuid())
  title   String?
  content String

  authorId    String
  clubId      String?
  communityId String?

  voteScore    Int @default(0)
  commentCount Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  author    User       @relation(fields: [authorId], references: [id], onDelete: Cascade)
  club      Club?      @relation(fields: [clubId], references: [id], onDelete: Cascade)
  community Community? @relation(fields: [communityId], references: [id], onDelete: Cascade)

  comments Comment[]
  likes    Like[]
  votes    PostVote[]

  @@index([authorId])
  @@index([clubId])
  @@index([communityId, createdAt])
  @@index([communityId, voteScore])
  @@index([voteScore])
  @@index([createdAt])
}

// ======================================================
// COMMENTS
// ======================================================

model Comment {
  id      String @id @default(uuid())
  content String

  authorId String
  postId   String
  parentId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  author  User      @relation(fields: [authorId], references: [id], onDelete: Cascade)
  post    Post      @relation(fields: [postId], references: [id], onDelete: Cascade)
  parent  Comment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies Comment[] @relation("CommentReplies")

  @@index([authorId])
  @@index([postId])
  @@index([parentId])
}

model PostVote {
  id String @id @default(uuid())

  userId String
  postId String
  value  Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([userId, postId])
  @@index([postId])
  @@index([userId])
}

// ======================================================
// LIKES
// ======================================================

model Like {
  id String @id @default(uuid())

  userId String
  postId String

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([userId, postId])
  @@index([userId])
  @@index([postId])
}

// ======================================================
// EVENTS / MEETINGS
// ======================================================

model Event {
  id          String  @id @default(uuid())
  title       String
  description String?

  location String?

  startsAt DateTime
  endsAt   DateTime?

  clubId String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  club Club @relation(fields: [clubId], references: [id], onDelete: Cascade)

  attendees EventAttendee[]

  @@index([clubId])
  @@index([startsAt])
}

model EventAttendee {
  id String @id @default(uuid())

  userId  String
  eventId String

  status AttendanceStatus @default(GOING)

  createdAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([userId, eventId])
  @@index([userId])
  @@index([eventId])
}

enum AttendanceStatus {
  GOING
  INTERESTED
}

// ======================================================
// UNIVERSITIES
// ======================================================

model University {
  id         String  @id @default(cuid())
  name       String  @unique
  nameArabic String?

  country String @default("Morocco")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  institutions Institution[]

  @@index([country])
}

// ======================================================
// INSTITUTIONS / SCHOOLS
// ======================================================

model Institution {
  id String @id @default(cuid())

  name         String
  abbreviation String?
  nameArabic   String?

  city    String
  country String @default("Morocco")

  address String?
  phone   String?
  fax     String?

  studentCount2023_2024 Int?

  universityId String
  university   University @relation(fields: [universityId], references: [id], onDelete: Cascade)

  users          User[]
  courses        Course[]
  studyResources StudyResource[]
  communities    Community[]
  clubs          Club[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([name, city])
  @@index([city])
  @@index([country])
  @@index([universityId])
}

// ======================================================
// STUDY RESOURCES
// ======================================================

enum ResourceType {
  NOTES
  SUMMARY
  EXAM
  EXERCISE
  ASSIGNMENT
  OTHER
}

model Course {
  id   String  @id @default(uuid())
  name String
  code String?

  institutionId String
  institution   Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)

  resources StudyResource[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([institutionId])
  @@index([institutionId, name])
  @@index([institutionId, code])
}

model StudyResource {
  id          String       @id @default(uuid())
  title       String
  description String?
  fileUrl     String
  fileName    String
  fileSize    Int?
  type        ResourceType

  academicYear String?
  professor    String?

  uploaderId    String
  institutionId String
  courseId      String?

  // Stored resource assets must be deleted through the resource service.
  uploader      User           @relation(fields: [uploaderId], references: [id], onDelete: Restrict)
  institution   Institution    @relation(fields: [institutionId], references: [id], onDelete: Restrict)
  course        Course?        @relation(fields: [courseId], references: [id], onDelete: SetNull)
  resourceViews ResourceView[]

  views     Int @default(0)
  downloads Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([institutionId, createdAt])
  @@index([institutionId, type])
  @@index([courseId])
  @@index([uploaderId])
}

model ResourceView {
  id         String   @id @default(uuid())
  resourceId String
  userId     String
  createdAt  DateTime @default(now())

  resource StudyResource @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  user     User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([resourceId, userId])
  @@index([userId])
}
